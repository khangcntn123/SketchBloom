---
import { renderPDF } from "../lib/render-pdf";

interface Props {
  src: ImageMetadata | `${string}.pdf`;
  alt: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
  maxDisplayWidth?: number;
  scale?: number;
  class?: string;
}

const {
  src,
  alt,
  priority = false,
  invertInDarkMode = false,
  maxDisplayWidth,
  scale = 1,
  class: className = "",
} = Astro.props;

let image: ImageMetadata;

if (typeof src === "string") {
  image = await renderPDF(src);
} else {
  image = src;
}

const sourceWidth = image.width;

/*
 * Base width before scaling.
 * If maxDisplayWidth is not provided, start from sourceWidth.
 */
const baseWidth =
  typeof maxDisplayWidth === "number"
    ? maxDisplayWidth
    : sourceWidth;

/*
 * Final display width.
 * scale = 1.2 means enlarge by 20%.
 */
const displayWidth = Math.round(baseWidth * scale);
---

<div class="paper-image-wrapper">
  <img
    src={image.src}
    alt={alt}
    width={image.width}
    height={image.height}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    decoding="async"
    class:list={[
      "paper-image",
      invertInDarkMode && "dark:invert",
      className,
    ]}
    style={`--source-width: ${displayWidth}px;`}
  />
</div>
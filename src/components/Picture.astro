---
import { Picture as AstroPicture } from "astro:assets";
import { renderPDF } from "../lib/render-pdf";

interface Props {
  src: ImageMetadata | `${string}.pdf`;
  alt: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
  class?: string;
}

const {
  src,
  alt,
  priority = false,
  invertInDarkMode = false,
  class: className = "",
} = Astro.props;

let image: ImageMetadata;

if (typeof src === "string") {
  image = await renderPDF(src);
} else {
  image = src;
}

const pictureClass = [
  "block",
  "h-auto",
  "w-full",
  "max-w-full",
  "rounded-lg",
  "object-contain",
  "mx-auto",
  invertInDarkMode ? "dark:invert" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<AstroPicture
  class={pictureClass}
  src={image}
  alt={alt}
  layout="constrained"
  formats={["avif"]}
  priority={priority}
  fit="contain"
/>
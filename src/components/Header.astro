---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type HeaderLink = {
  name: string;
  url?: string;
  icon?: string;
  disabled?: boolean;
  newTab?: boolean;
};

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: HeaderLink[];
}

const {
  title,
  authors,
  conference,
  notes = [],
  links = [],
} = Astro.props;

/*
 * BASE_URL is "/" during normal local development.
 * On GitHub Pages it may be "/sketchbloom_test_1/".
 */
const rawBase = import.meta.env.BASE_URL;

const baseUrl = rawBase.endsWith("/")
  ? rawBase
  : `${rawBase}/`;

function resolveUrl(url?: string): string {
  if (!url) {
    return "#";
  }

  /*
   * Preserve anchors, external URLs, email URLs,
   * telephone URLs, and protocol-relative URLs.
   */
  if (
    url.startsWith("#") ||
    url.startsWith("//") ||
    /^[a-z][a-z\d+\-.]*:/i.test(url)
  ) {
    return url;
  }

  return `${baseUrl}${url.replace(/^\/+/, "")}`;
}
---

<header class="paper-header">
  <div class="paper-header__inner">
    <h1 class="paper-header__title">
      {title}
    </h1>

    {
      authors.length > 0 && (
        <div class="paper-header__authors">
          {authors.map((author) => (
            <div class="paper-header__author">
              <div class="paper-header__author-name">
                {
                  author.url ? (
                    <a href={author.url}>{author.name}</a>
                  ) : (
                    author.name
                  )
                }

                {
                  author.notes?.length ? (
                    <sup class="paper-header__author-notes">
                      {author.notes.join(",")}
                    </sup>
                  ) : null
                }
              </div>

              {
                author.institution && (
                  <div class="paper-header__author-inst">
                    {author.institution}
                  </div>
                )
              }
            </div>
          ))}
        </div>
      )
    }

    {
      conference && (
        <div class="paper-header__conference">
          {conference}
        </div>
      )
    }

    {
      notes.length > 0 && (
        <div class="paper-header__notes">
          {notes.map((note) => (
            <span>
              <sup>{note.symbol}</sup>
              {note.text}
            </span>
          ))}
        </div>
      )
    }

    {
      links.length > 0 && (
        <nav
          class="paper-header__links"
          aria-label="Paper resources"
        >
          {links.map((link) =>
            link.disabled ? (
              <span
                class="paper-header__button paper-header__button--disabled"
                aria-disabled="true"
                title="This resource is not available yet"
              >
                {
                  link.icon && (
                    <Icon
                      name={link.icon}
                      class="paper-header__button-icon"
                    />
                  )
                }

                <span>{link.name}</span>
              </span>
            ) : (
              <a
                href={resolveUrl(link.url)}
                class="paper-header__button"
                target={link.newTab ? "_blank" : undefined}
                rel={link.newTab ? "noreferrer" : undefined}
              >
                {
                  link.icon && (
                    <Icon
                      name={link.icon}
                      class="paper-header__button-icon"
                    />
                  )
                }

                <span>{link.name}</span>
              </a>
            )
          )}
        </nav>
      )
    }
  </div>
</header>
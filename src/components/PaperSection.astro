---
interface Props {
  id?: string;
  tone?: "default" | "muted";
}

const {
  id,
  tone = "default",
} = Astro.props;
---

<section
  id={id}
  class:list={[
    "paper-section scroll-mt-16",
    tone === "muted" &&
      "full-bleed bg-zinc-100 px-[var(--actual-inline-margin)] py-14 dark:bg-zinc-900",
  ]}
>
  <div
    class="w-full [&>:first-child]:mt-0 [&>:last-child]:mb-0"
  >
    <slot />
  </div>
</section>
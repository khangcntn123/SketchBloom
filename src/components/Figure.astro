---
interface Props {
  variant?: "default" | "hero";
}

const {
  variant = "default",
} = Astro.props;

const hasCaption = Astro.slots.has("caption");
---

<figure
  class:list={[
    "paper-figure",
    "not-prose",
    variant === "hero" && "paper-figure--hero",
  ]}
>
  <div class="paper-figure__media">
    <slot name="figure" />
  </div>

  {
    hasCaption && (
      <figcaption class="paper-figure__caption">
        <div class="paper-figure__caption-inner">
          <slot name="caption" />
        </div>
      </figcaption>
    )
  }
</figure>